              "mode": "raw",
              "raw": "{\n  \"event_id\": \"pm-direct-{{$timestamp}}\",\n  \"name\": \"Direct\",\n  \"phone\": \"050 999 0000\",\n  \"email\": \"direct@example.test\",\n  \"message\": \"hi\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": []
        }
      ],
      "description": "Skip these in the Collection Runner."
    }
