# copy to .env and change all values (.env is gitignored)
# these are just placeholders

# crm postgres
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=crm

# mock crm
# secret the n8n error workflow uses for POST /alerts
INTERNAL_ALERT_TOKEN=change-me-internal-alert-token
# test only, turns on /_debug/fail-next. keep false anywhere real
ENABLE_FAIL_INJECTION=true

# n8n
# n8n encrypts its saved credentials with this. back it up separately,
# without it restored credentials can't be decrypted
N8N_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32
