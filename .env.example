# Copy to .env and replace every value. .env is gitignored.
# All values here are SYNTHETIC placeholders for local testing only.

# --- CRM Postgres ---
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=crm

# --- Mock CRM ---
# Shared secret n8n's error workflow uses to call POST /alerts (not a user token).
INTERNAL_ALERT_TOKEN=change-me-internal-alert-token
# TEST-ONLY: enables POST /_debug/fail-next. Must be false in any real deployment.
ENABLE_FAIL_INJECTION=true

# --- n8n ---
# Encrypts credentials stored inside n8n. Back this up separately; losing it
# makes n8n's stored credentials unreadable after a restore.
N8N_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32
